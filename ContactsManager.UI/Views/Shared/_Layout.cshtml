<!DOCTYPE html>

<html>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<title>CRUD @ViewBag.Title</title>
	<link href="~/StylesSheet.css" rel="stylesheet" />
	<link rel="stylesheet"
				href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
				integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
				crossorigin="anonymous"
				referrerpolicy="no-referrer" />
</head>
<body>
	<div class="page-content">

		<div class="margin-bottom">

			<div class="flex" id="top-bar-div">
				<div class="flex-1" id="app-title-div">

					<h1 class="app-title">
						<i class="fa-solid fa-people-simple"></i>
						Contact Manager

					</h1>
				</div>

				<div class="flex-1 pr" id="search-box-div">

					<div class="navbar account-links">
						<ul>
							@if (User.Identity.IsAuthenticated)
							{
								<li>
									<i class="fa-solid fa-user"></i>
									@(User.Identity?.Name ?? "Guest")
								</li>
								<li>
									<a asp-controller="Account" asp-action="Logout">Logout</a>
								</li>
							}
							else
							{
								<li>
									<a class="@((ViewBag.Url == "~/Account/Register") ? "nav-active" : "")"
										 asp-controller="Account"
										 asp-action="Register">Register</a>
								</li>
								<li>
									<a class="@((ViewBag.Url == "~/Account/Login") ? "nav-active" : "")"
										 asp-controller="Account"
										 asp-action="Login">Login</a>
								</li>
							}
						</ul>
					</div>

				</div>
			</div>

		</div>

		<div class="navbar mb">
			<ul>
				<li>
					<a class="@((ViewBag.Url == "~/Persons/Index") ? "nav-active" : "")"
						 asp-controller="Persons"
						 asp-action="Index">Persons</a>
					<a class="@((ViewBag.Url == "~/Countries/UploadFromExcel") ? "nav-active" : "")"
						 asp-controller="Countries"
						 asp-action="UploadFromExcel">Upload Countries</a>
				</li>
			</ul>
		</div>

		<div class="body">
			@RenderBody()
		</div>
	</div>
	@RenderSection("scripts", required: false)
</body>
</html>
