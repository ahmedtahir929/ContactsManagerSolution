@{
	ViewBag.Title = "Upload Countries from Excel";
	ViewBag.ControllerName = "Countries";
	ViewBag.PageName = "Upload From Excel";
	ViewBag.Url = "~/Countries/UploadFromExcel";
}

<partial name="_BreadCrumbsNav" />

<div class="form-container">
	<h2 class="text-large">Upload Countries from Excel</h2>

	<form asp-action="UploadFromExcel" asp-controller="Countries" method="post" enctype="multipart/form-data">

		@* ExcelFile *@
		<div class="form-input flex">
			<div class="w-25">
				<label class="form-label pt">Choose an excel file</label>
			</div>
			<div class="flex-1">
				<input type="file" name="excelFile" class="form-input" />
				<div class="text-red">@ViewBag.ErrorMessage</div>
				<div class="text-green">@ViewBag.SuccessMessage</div>
			</div>

			<div class="flex">
				<div class="w-25"></div>
				<div class="flex-1">
					<button type="submit" class="button button-green-back">Upload</button>
				</div>
			</div>
		</div>

	</form>
</div>
